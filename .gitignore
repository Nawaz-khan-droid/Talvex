# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Python bytecode and cache
__pycache__/
*.pyc
*.pyo

# Local SQLite databases
db/*.db

# ==================== ADD THESE ====================

# Python virtual environments (CRITICAL - avoids pushing 1GB+ venv)
.venv/
venv/
ENV/

# Uploads and data files
uploads/
data/*.faiss
data/*.pkl
data/*.csv

# SSL / credential files
*.key
*.crt
*.c12
credentials.json
service-account*.json
secrets.*

# IDE folders (not secrets but clutter)
.vscode/
.idea/